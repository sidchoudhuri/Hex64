3230 CH=72+2*K:B=14336+CH*8:FOR Z=0 TO 15:POKE B+Z,0:NEXT
3235 ZO=0:IF L>8 THEN ZO=L-8:REM OVER 8 FOR A MOMENT: SHOW THE TOP 8
3240 FOR Z=1 TO L-ZO:POKE B+17-2*Z,PB%(ASC(MID$(S$(K),Z+ZO,1))-48):NEXT
