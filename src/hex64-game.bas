6038 NEXT:FI=-(TT>=CL):REM FINISHING: PULL EVERY MATCHING CHIP, NO 8 LIMIT
6040 FOR I=1 TO 6:N=AD%(X,I):IF N=0 THEN 6100
6050 IF HO%(N) OR S$(N)="" THEN 6100
6060 IF RIGHT$(S$(N),1)<>C$ THEN 6100
6065 MV=0
6070 IF S$(N)="" OR (LEN(S$(X))>7 AND FI=0) THEN 6080
6075 IF RIGHT$(S$(N),1)<>C$ THEN 6080
6077 S$(X)=S$(X)+C$:S$(N)=LEFT$(S$(N),LEN(S$(N))-1):MV=1:GOTO 6070
6080 IF MV=0 THEN 6100
6085 K=N:GOSUB 3200:K=X:GOSUB 3200:GOSUB 8300
